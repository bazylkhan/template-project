{
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit",
        "source.fixAll.stylelint": "explicit"
    },
    "eslint.options": {
        "configFile": ".eslintrc.js"
    },
    "eslint.validate": [
        "javascript",
        "javascriptreact",
        "typescript",
        "typescriptreact"
    ],
    "stylelint.configFile": ".stylelintrc.js",
    "stylelint.validate": [
        "css",
        "scss",
        "sass"
    ],
    "scss.validate": false
}